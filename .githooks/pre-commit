#!/bin/sh
# BeatBoard pre-commit hook
# Runs: ruff format .  +  ruff check .
# Auto-stages formatting changes so the commit includes them.

set -e

# Locate ruff
if command -v ruff >/dev/null 2>&1; then
  RUFF="ruff"
elif python -m ruff --version >/dev/null 2>&1; then
  RUFF="python -m ruff"
else
  echo "ruff not found (tried 'ruff' and 'python -m ruff'). Skipping hook."
  exit 0
fi

echo "▶ ruff format ."
$RUFF format .

# If formatting changed any tracked files, stage the changes.
# `git diff --quiet` exits 0 when no unstaged changes; we invert for sh compatible.
if ! git diff --quiet 2>/dev/null; then
  git add -u
  echo "  → staged formatting changes (git add -u)"
fi

echo "▶ ruff check ."
$RUFF check .

echo "✓ ruff checks passed"
